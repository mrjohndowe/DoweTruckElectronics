SiiNunit
{
    # Radar Detector Screen UI Definition
    # This defines the in-game UI for the radar detector display

    ui_template: .dowe_radar_screen
    {
        type: "display"
        name: "Dowe Radar Screen"
        width: 400
        height: 200

        # Screen background
        background: (0.0, 0.0, 0.0, 1.0)

        # Band display
        element: .band_display
        {
            type: "text"
            position: (20, 20)
            size: (100, 50)
            text: "$$band"
            font: "font_bold"
            color: (1.0, 0.2, 0.2, 1.0)
            font_size: 32
            alignment: "center"
        }

        element: .frequency_display
        {
            type: "text"
            position: (20, 70)
            size: (100, 30)
            text: "$$frequency GHz"
            font: "font_regular"
            color: (1.0, 1.0, 1.0, 1.0)
            font_size: 16
            alignment: "center"
        }

        # Signal strength display (simplified as text for SCS compatibility)
        element: .signal_strength
        {
            type: "text"
            position: (140, 60)
            size: (60, 80)
            text: "$$signal_strength"
            font: "font_bold"
            color: (1.0, 0.2, 0.2, 1.0)
            font_size: 24
            alignment: "center"
        }

        # Direction arrows
        element: .arrow_left
        {
            type: "text"
            position: (220, 60)
            size: (40, 40)
            text: "←"
            font: "font_bold"
            color: (0.5, 0.5, 0.5, 1.0)
            font_size: 32
            alignment: "center"
        }

        element: .arrow_front
        {
            type: "text"
            position: (270, 40)
            size: (40, 40)
            text: "↑"
            font: "font_bold"
            color: (1.0, 0.2, 0.2, 1.0)
            font_size: 32
            alignment: "center"
        }

        element: .arrow_right
        {
            type: "text"
            position: (320, 60)
            size: (40, 40)
            text: "→"
            font: "font_bold"
            color: (0.5, 0.5, 0.5, 1.0)
            font_size: 32
            alignment: "center"
        }

        # Bogey counter
        element: .bogey_label
        {
            type: "text"
            position: (290, 20)
            size: (60, 20)
            text: "Alerts"
            font: "font_regular"
            color: (0.8, 0.8, 0.8, 1.0)
            font_size: 12
            alignment: "center"
        }

        element: .bogey_count
        {
            type: "text"
            position: (290, 40)
            size: (60, 30)
            text: "$$bogey"
            font: "font_bold"
            color: (1.0, 0.2, 0.2, 1.0)
            font_size: 24
            alignment: "center"
        }

        # Sensitivity mode
        element: .sensitivity
        {
            type: "text"
            position: (290, 80)
            size: (60, 20)
            text: "$$sensitivity"
            font: "font_regular"
            color: (0.0, 0.8, 1.0, 1.0)
            font_size: 12
            alignment: "center"
        }

        # Mute indicator
        element: .mute_indicator
        {
            type: "text"
            position: (290, 110)
            size: (60, 20)
            text: "$$mute"
            font: "font_regular"
            color: (1.0, 0.5, 0.0, 1.0)
            font_size: 12
            alignment: "center"
        }

        # Screen brightness animation
        animation: brightness
        {
            type: "float"
            name: "display_brightness"
            from: 0.0
            to: 1.0
            duration: 1.5
            easing: "ease_out"
        }
    }
}
