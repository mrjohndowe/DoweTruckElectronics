SiiNunit
{
    # Dowe Truck Electronics - Truck Accessory Configuration
    # This file provides a template for adding the ELD and radar detector to trucks
    #
    # For production use, create separate accessory files for each truck:
    # def/vehicle/truck/kenworth.w900/accessory/dowe_eld.sii
    # def/vehicle/truck/peterbilt.389/accessory/dowe_eld.sii
    # def/vehicle/truck/freightliner.cascadia/accessory/dowe_eld.sii
    # etc.
    #
    # Each file should define the appropriate slot names and positions for that truck
    #
    # Common slot names:
    # - Slot 11: Dashboard accessories
    # - Slot 13: Overhead console accessories
    # - Slot 14: Windshield accessories
    #
    # Example configuration for a truck:
    #
    # accessory_wheel: .dowe_eld
    # {
    #     slot_name: 14
    #     slot_hookup: "ntrl"
    #     default_offset: (0.0, 0.3, 0.5)
    #     default_rotation: (0.0, 0.0, 0.0)
    # }
}
