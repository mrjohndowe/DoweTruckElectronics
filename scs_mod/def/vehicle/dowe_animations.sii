SiiNunit
{
    # Common animation definitions for Dowe Truck Electronics
    # These animations are referenced by the accessory definitions

    # ELD Screen State Animations
    animation_set: .eld_screen_states
    {
        animation: screen_off
        {
            type: "float"
            name: "screen_brightness"
            value: 0.0
        }

        animation: screen_on
        {
            type: "float"
            name: "screen_brightness"
            value: 1.0
        }

        animation: screen_dim
        {
            type: "float"
            name: "screen_brightness"
            value: 0.3
        }

        animation: screen_low
        {
            type: "float"
            name: "screen_brightness"
            value: 0.5
        }
    }

    # ELD Touch Feedback Animations
    animation_set: .eld_touch_feedback
    {
        animation: touch_ripple
        {
            type: "float"
            name: "touch_effect"
            from: 0.0
            to: 1.0
            duration: 0.2
            easing: "ease_out"
        }

        animation: touch_ripple_fade
        {
            type: "float"
            name: "touch_effect"
            from: 1.0
            to: 0.0
            duration: 0.3
            easing: "ease_in"
        }
    }

    # Radar LED State Animations
    animation_set: .radar_led_states
    {
        animation: all_leds_off
        {
            type: "sequential"
            duration: 0.1
            nodes: 5
            nodes[0]: x_led { type: "bool" value: false }
            nodes[1]: k_led { type: "bool" value: false }
            nodes[2]: ka_led { type: "bool" value: false }
            nodes[3]: laser_led { type: "bool" value: false }
            nodes[4]: mute_led { type: "bool" value: false }
        }

        animation: x_led_on
        {
            type: "bool"
            name: "x_led"
            value: true
        }

        animation: k_led_on
        {
            type: "bool"
            name: "k_led"
            value: true
        }

        animation: ka_led_on
        {
            type: "bool"
            name: "ka_led"
            value: true
        }

        animation: laser_led_on
        {
            type: "bool"
            name: "laser_led"
            value: true
        }

        animation: mute_led_on
        {
            type: "bool"
            name: "mute_led"
            value: true
        }
    }

    # Radar Signal Strength Animations
    animation_set: .radar_signal_strength
    {
        animation: signal_0
        {
            type: "float"
            name: "signal_strength"
            value: 0.0
        }

        animation: signal_1
        {
            type: "float"
            name: "signal_strength"
            value: 0.14
        }

        animation: signal_2
        {
            type: "float"
            name: "signal_strength"
            value: 0.28
        }

        animation: signal_3
        {
            type: "float"
            name: "signal_strength"
            value: 0.42
        }

        animation: signal_4
        {
            type: "float"
            name: "signal_strength"
            value: 0.56
        }

        animation: signal_5
        {
            type: "float"
            name: "signal_strength"
            value: 0.70
        }

        animation: signal_6
        {
            type: "float"
            name: "signal_strength"
            value: 0.84
        }

        animation: signal_7
        {
            type: "float"
            name: "signal_strength"
            value: 1.0
        }
    }

    # Radar Direction Arrow Animations
    animation_set: .radar_direction_arrows
    {
        animation: arrows_off
        {
            type: "sequential"
            duration: 0.1
            nodes: 3
            nodes[0]: arrow_front { type: "float" name: "arrow_front_brightness" value: 0.0 }
            nodes[1]: arrow_rear { type: "float" name: "arrow_rear_brightness" value: 0.0 }
            nodes[2]: arrow_side { type: "float" name: "arrow_side_brightness" value: 0.0 }
        }

        animation: arrow_front_on
        {
            type: "float"
            name: "arrow_front_brightness"
            value: 1.0
        }

        animation: arrow_rear_on
        {
            type: "float"
            name: "arrow_rear_brightness"
            value: 1.0
        }

        animation: arrow_side_on
        {
            type: "float"
            name: "arrow_side_brightness"
            value: 1.0
        }
    }

    # Bogey Counter Animations
    animation_set: .radar_bogey_counter
    {
        animation: bogey_0
        {
            type: "bool"
            name: "bogey_display"
            value: false
        }

        animation: bogey_1
        {
            type: "sequential"
            duration: 0.1
            nodes: 2
            nodes[0]: bogey_display { type: "bool" value: true }
            nodes[1]: bogey_count { type: "float" name: "bogey_value" value: 1.0 }
        }

        animation: bogey_2
        {
            type: "sequential"
            duration: 0.1
            nodes: 2
            nodes[0]: bogey_display { type: "bool" value: true }
            nodes[1]: bogey_count { type: "float" name: "bogey_value" value: 2.0 }
        }

        animation: bogey_3
        {
            type: "sequential"
            duration: 0.1
            nodes: 2
            nodes[0]: bogey_display { type: "bool" value: true }
            nodes[1]: bogey_count { type: "float" name: "bogey_value" value: 3.0 }
        }
    }
}
