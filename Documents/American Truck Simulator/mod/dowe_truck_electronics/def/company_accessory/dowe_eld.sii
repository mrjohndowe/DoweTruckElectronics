SiiNunit
{
    # ELD Tablet Accessory
    accessory_slot_data: .dowe_eld
    {
        name: "Dowe ELD Tablet"
        price: 450
        unlock_level: 0

        # ELD Model
        model: "model/eld/dowe_eld.pmd"
        coll_mask: 1
        mass: 0.5

        # Material
        material: "material/model/eld/dowe_eld.mat"

        # Note: Animations are defined in the model file (.pmd) using SCS animation system
        # The external application will control screen brightness and states
        # through UI hooks when implemented

        # Mount positions - these are placeholder positions
        # Actual positions need to be adjusted per truck based on interior layout
        accessory_slot_data: .mount_windshield
        {
            slot_name: "slot_14"
            offset: (0.0, 0.3, 0.5)
            rotation: (0.0, 0.0, 0.0)
        }

        accessory_slot_data: .mount_dashboard
        {
            slot_name: "slot_11"
            offset: (0.0, 0.2, 0.0)
            rotation: (0.0, 0.0, 0.0)
        }

        accessory_slot_data: .mount_overhead
        {
            slot_name: "slot_13"
            offset: (0.0, 0.1, 0.0)
            rotation: (0.0, 0.0, 0.0)
        }
    }
}
