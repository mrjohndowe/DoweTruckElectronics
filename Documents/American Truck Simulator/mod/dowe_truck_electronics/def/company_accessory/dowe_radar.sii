SiiNunit
{
    # Radar Detector Accessory
    accessory_slot_data: .dowe_radar
    {
        name: "Dowe Radar Detector"
        price: 350
        unlock_level: 0

        # Radar Detector Model
        model: "model/radar/dowe_radar.pmd"
        coll_mask: 1
        mass: 0.3

        # Material
        material: "material/model/radar/dowe_radar.mat"

        # Note: Animations are defined in the model file (.pmd) using SCS animation system
        # The external application will control LED states and display brightness
        # through model hookups when implemented

        # Mount positions - these are placeholder positions
        # Actual positions need to be adjusted per truck based on interior layout
        accessory_slot_data: .mount_windshield
        {
            slot_name: "slot_14"
            offset: (0.0, 0.35, 0.45)
            rotation: (0.0, 0.0, 0.0)
        }

        accessory_slot_data: .mount_dashboard
        {
            slot_name: "slot_11"
            offset: (0.0, 0.15, 0.0)
            rotation: (0.0, 0.0, 0.0)
        }

        accessory_slot_data: .mount_overhead
        {
            slot_name: "slot_13"
            offset: (0.0, 0.1, 0.0)
            rotation: (0.0, 0.0, 0.0)
        }
    }
}
